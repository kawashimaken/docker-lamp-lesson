# このファイルを .env にコピーして、自分の値を設定してください。
# .env は .gitignore 済みです。コミットしないでください。

# MySQLのrootパスワード（任意の値に変更してください）
MYSQL_ROOT_PASSWORD=

# アプリのパスワードsalt用シークレット（任意の長いランダム文字列に変更してください）
# 変更すると既存ユーザーのログインができなくなります（ハッシュが変わるため）。
APP_PASSWORD_SALT_SECRET=

# 以下は既定値のままで動きます
MYSQL_HOST=mysql
MYSQL_DATABASE=greatappdb
MYSQL_USER=root
